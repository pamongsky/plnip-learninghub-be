# PRODUCTION Environment Configuration Template
# Copy this to .env.production and update with real production values

# ============================================
# APPLICATION CONFIGURATION
# ============================================
APP_NAME="PLNIP Portal"
APP_ENV=production
APP_KEY=base64:GENERATE_NEW_KEY_WITH_php_artisan_key:generate
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://portal.plnip.ac.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ============================================
# DATABASE CONFIGURATION - PORTAL (MySQL)
# ============================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=plnip_portal
DB_USERNAME=production_user
DB_PASSWORD=STRONG_PASSWORD_HERE

# ============================================
# DATABASE CONFIGURATION - MOODLE (Oracle)
# ============================================
MOODLE_DB_CONNECTION=oracle
MOODLE_DB_HOST=127.0.0.1
MOODLE_DB_PORT=1521
MOODLE_DB_DATABASE=XEPDB1
MOODLE_DB_SERVICE_NAME=XEPDB1
MOODLE_DB_USERNAME=moodle_user
MOODLE_DB_PASSWORD=STRONG_PASSWORD_HERE

# ============================================
# CACHE & SESSION CONFIGURATION
# ============================================
BROADCAST_CONNECTION=pusher
CACHE_STORE=redis
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.plnip.ac.id
SESSION_SECURE_COOKIE=true

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

# ============================================
# MAIL CONFIGURATION
# ============================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@plnip.ac.id
MAIL_PASSWORD=MAIL_APP_PASSWORD_HERE
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@plnip.ac.id
MAIL_FROM_NAME="${APP_NAME}"

# ============================================
# BROADCASTING - PUSHER CONFIGURATION
# ============================================
PUSHER_APP_ID=your_production_pusher_app_id
PUSHER_APP_KEY=your_production_pusher_key
PUSHER_APP_SECRET=your_production_pusher_secret
PUSHER_APP_CLUSTER=ap1
PUSHER_SCHEME=https
PUSHER_HOST=
PUSHER_PORT=443

# ============================================
# CORS CONFIGURATION
# ============================================
SANCTUM_STATEFUL_DOMAINS=portal.plnip.ac.id,www.portal.plnip.ac.id
SESSION_DOMAIN=.plnip.ac.id
FRONTEND_URL=https://portal.plnip.ac.id

# ============================================
# FILESYSTEM CONFIGURATION
# ============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================
# VITE CONFIGURATION (for asset compilation)
# ============================================
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ============================================
# SECURITY & PERFORMANCE
# ============================================
# Enable OPcache in php.ini
# opcache.enable=1
# opcache.memory_consumption=256
# opcache.interned_strings_buffer=16
# opcache.max_accelerated_files=10000
# opcache.revalidate_freq=0
# opcache.validate_timestamps=0 (set to 0 in production)

# Set proper file permissions:
# chmod -R 775 storage bootstrap/cache
# chown -R www-data:www-data storage bootstrap/cache

# ============================================
# MONITORING & ERROR TRACKING (Optional)
# ============================================
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================
# RATE LIMITING
# ============================================
THROTTLE_REQUESTS_PER_MINUTE=60
THROTTLE_API_REQUESTS_PER_MINUTE=100

# ============================================
# BACKUP CONFIGURATION (Optional)
# ============================================
BACKUP_DISK=s3
BACKUP_NOTIFICATION_EMAIL=admin@plnip.ac.id

# ============================================
# NOTES FOR PRODUCTION DEPLOYMENT
# ============================================
# 1. Run: php artisan key:generate (to generate APP_KEY)
# 2. Set APP_DEBUG=false
# 3. Set APP_ENV=production
# 4. Use strong passwords for all database connections
# 5. Enable HTTPS (SESSION_SECURE_COOKIE=true requires HTTPS)
# 6. Configure proper CORS domains
# 7. Set up supervisor for queue workers
# 8. Enable Redis for better performance
# 9. Configure backup strategy
# 10. Set up monitoring and error tracking
